#include <iostream>
#include <string>
#include <map>
#include <opencv2/opencv.hpp>
#include <vector>
#include <algorithm>
#include <limits>

using namespace std;
using namespace cv;

// Code 39 encoding table
// 0 = Narrow, 1 = Wide

map<char, string> code39 =
{
    {'0', "000110100"},
    {'1', "100100001"},
    {'2', "001100001"},
    {'3', "101100000"},
    {'4', "000110001"},
    {'5', "100110000"},
    {'6', "001110000"},
    {'7', "000100101"},
    {'8', "100100100"},
    {'9', "001100100"},
    {'*', "010010100"}
};

// Barcode dimensions
const int NARROW = 3;
const int WIDE = 9;

const int BAR_HEIGHT = 125;
const int QUIET_ZONE = 60;
const int IMAGE_HEIGHT = 190;

// Function 1: Validate six-digit number
bool validateNumber(string number)
{
    if (number.length() != 6)
        return false;

    for (int i = 0; i < number.length(); i++)
    {
        if (number[i] < '0' || number[i] > '9')
            return false;
    }

    return true;
}

// Function 2: Get width of an element
int getWidth(char element)
{
    if (element == '0')
        return NARROW;

    return WIDE;
}

// Function 3: Calculate total image width
int calculateWidth(string data)
{
    int totalWidth = QUIET_ZONE * 2;

    for (int i = 0; i < data.length(); i++)
    {
        string pattern = code39.at(data[i]);

        for (int j = 0; j < pattern.length(); j++)
        {
            totalWidth += getWidth(pattern[j]);
        }

        // Space between characters
        if (i != data.length() - 1)
            totalWidth += NARROW;
    }

    return totalWidth;
}

// Function 4: Draw barcode
Mat drawBarcode(string data)
{
    int width = calculateWidth(data);

    // Create white image
    Mat image(
        IMAGE_HEIGHT,
        width,
        CV_8UC3,
        Scalar(255, 255, 255)
    );

    int x = QUIET_ZONE;

    for (int i = 0; i < data.length(); i++)
    {
        string pattern = code39.at(data[i]);

        for (int j = 0; j < pattern.length(); j++)
        {
            int elementWidth = getWidth(pattern[j]);

            // Even positions represent black bars
            if (j % 2 == 0)
            {
                rectangle(
                    image,
                    Rect(x, 10, elementWidth, BAR_HEIGHT),
                    Scalar(0, 0, 0),
                    FILLED
                );
            }

            x += elementWidth;
        }

        // Add white gap between characters
        if (i != data.length() - 1)
            x += NARROW;
    }

    return image;
}




