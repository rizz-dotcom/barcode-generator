# Automatically detect text files
* text=auto

# C++ source files
*.cpp text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.cc  text eol=lf
*.c   text eol=lf

# Documentation and configuration
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf

# Git configuration files
.gitattributes text eol=lf
.gitignore    text eol=lf

# Binary images and resources
*.png  binary
*.jpg  binary
*.jpeg binary
*.bmp  binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary

# Compiled binaries and libraries
*.exe binary
*.dll binary
*.lib binary
*.a   binary
