#include <iostream>
#include <string>
#include <map>
#include <opencv2/opencv.hpp>
#include <vector>
#include <algorithm>
#include <limits>

using namespace std;
using namespace cv;

// Code 39 encoding table
// 0 = Narrow, 1 = Wide

map<char, string> code39 =
{
    {'0', "000110100"},
    {'1', "100100001"},
    {'2', "001100001"},
    {'3', "101100000"},
    {'4', "000110001"},
    {'5', "100110000"},
    {'6', "001110000"},
    {'7', "000100101"},
    {'8', "100100100"},
    {'9', "001100100"},
    {'*', "010010100"}
};

// Barcode dimensions
const int NARROW = 3;
const int WIDE = 9;

const int BAR_HEIGHT = 125;
const int QUIET_ZONE = 60;
const int IMAGE_HEIGHT = 190;

// Function 1: Validate six-digit number
bool validateNumber(string number)
{
    if (number.length() != 6)
        return false;

    for (int i = 0; i < number.length(); i++)
    {
        if (number[i] < '0' || number[i] > '9')
            return false;
    }

    return true;
}

// Function 2: Get width of an element
int getWidth(char element)
{
    if (element == '0')
        return NARROW;

    return WIDE;
}

// Function 3: Calculate total image width
int calculateWidth(string data)
{
    int totalWidth = QUIET_ZONE * 2;

    for (int i = 0; i < data.length(); i++)
    {
        string pattern = code39.at(data[i]);

        for (int j = 0; j < pattern.length(); j++)
        {
            totalWidth += getWidth(pattern[j]);
        }

        // Space between characters
        if (i != data.length() - 1)
            totalWidth += NARROW;
    }

    return totalWidth;
}

// Function 4: Draw barcode
Mat drawBarcode(string data)
{
    int width = calculateWidth(data);

    // Create white image
    Mat image(
        IMAGE_HEIGHT,
        width,
        CV_8UC3,
        Scalar(255, 255, 255)
    );

    int x = QUIET_ZONE;

    for (int i = 0; i < data.length(); i++)
    {
        string pattern = code39.at(data[i]);

        for (int j = 0; j < pattern.length(); j++)
        {
            int elementWidth = getWidth(pattern[j]);

            // Even positions represent black bars
            if (j % 2 == 0)
            {
                rectangle(
                    image,
                    Rect(x, 10, elementWidth, BAR_HEIGHT),
                    Scalar(0, 0, 0),
                    FILLED
                );
            }

            x += elementWidth;
        }

        // Add white gap between characters
        if (i != data.length() - 1)
            x += NARROW;
    }

    return image;
}

// Function 5: Add human-readable number
void addNumber(Mat& image, string number)
{
    int font = FONT_HERSHEY_SIMPLEX;
    double scale = 0.8;
    int thickness = 2;

    int baseline;

    Size textSize = getTextSize(
        number,
        font,
        scale,
        thickness,
        &baseline
    );

    int x = (image.cols - textSize.width) / 2;

    putText(
        image,
        number,
        Point(x, 175),
        font,
        scale,
        Scalar(0, 0, 0),
        thickness
    );
}

// Function 6: Generate and save barcode
void generateBarcode(string number)
{
    if (!validateNumber(number))
    {
        cout << "Invalid input! Enter exactly six digits.\n";
        return;
    }

    // Add start and stop characters
    string data = "*" + number + "*";

    // Generate barcode image
    Mat barcode = drawBarcode(data);

    // Add number below barcode
    addNumber(barcode, number);

    // Save image
    if (imwrite("barcode.bmp", barcode))
    {
        cout << "\nBarcode generated successfully!\n";
        cout << "Saved as barcode.bmp\n";

        imshow("Generated Barcode", barcode);
        waitKey(0);
        destroyAllWindows();
    }
    else
    {
        cout << "Unable to save barcode image!\n";
    }
}


// One continuous group of pixels
struct Run
{
    bool black;
    int width;
};

// Function 1: Read pixels and count consecutive colors (zaab) ->
vector<Run> getRuns(Mat image, int row)
{
    vector<Run> runs;

    bool currentColor = false;
    int count = 0;
    bool started = false;

    for (int x = 0; x < image.cols; x++)
    {
        bool black = image.at<uchar>(row, x) < 128;

        // Ignore white space before barcode
        if (!started)
        {
            if (!black)
                continue;

            currentColor = true;
            count = 1;
            started = true;
        }
        else if (black == currentColor)
        {
            count++;
        }
        else
        {
            runs.push_back({ currentColor, count });

            currentColor = black;
            count = 1;
        }
    }

    if (started)
        runs.push_back({ currentColor, count });

    return runs;
}


// Function 2: Convert nine widths into a pattern
string getPattern(vector<Run> runs, int start)
{
    vector<int> positions;

    for (int i = 0; i < 9; i++)
    {
        positions.push_back(i);
    }

    // Sort positions according to their pixel widths
    sort(positions.begin(), positions.end(),
        [&](int a, int b)
        {
            return runs[start + a].width >
                runs[start + b].width;
        });

    // Three largest should be wide
    int smallestWide = runs[start + positions[2]].width;
    int largestNarrow = runs[start + positions[3]].width;

    // Check that wide and narrow are distinguishable
    if (smallestWide < largestNarrow * 1.7)
        return "";

    string pattern = "000000000";

    for (int i = 0; i < 3; i++)
    {
        pattern[positions[i]] = '1';
    }

    return pattern;
}   // <--
